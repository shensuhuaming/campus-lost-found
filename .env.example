# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，切勿提交）
# 测试同学部署时只需关心本文件

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=campus_lost_found
MYSQL_USER=clf
MYSQL_PASSWORD=change-me
# 容器端口映射到宿主机，本机已有 MySQL 占用 3306，故默认 3307
MYSQL_PORT=3307

# ---- 后端 ----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=dev-only-secret-change-in-production

# ---- 前端 ----
FRONTEND_PORT=80

# ---- 版本标签（打 tag 时同步）----
APP_VERSION=0.1.0
