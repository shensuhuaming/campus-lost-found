# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，切勿提交）
# 测试同学部署时只需关心本文件

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=lost_found
MYSQL_USER=clf
MYSQL_PASSWORD=change-me
# 容器端口映射到宿主机，本机已有 MySQL 占用 3306，故默认 3307
MYSQL_PORT=3307

# ---- 后端 ----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=dev-only-secret-change-in-production
# 管理员初始口令（首次启动创建 admin 账号时使用，生产必须改）
ADMIN_INIT_PASSWORD=Admin@123

# ---- 前端 ----
FRONTEND_PORT=80

# ---- 版本标签（打 tag 时同步）----
APP_VERSION=1.1.0
