<mxfile host="app.diagrams.net"><diagram id="d" name="图6-3-注册时序图"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" page="1" pageWidth="1520" pageHeight="1051"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="part1" value="用户／浏览器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11.0;" vertex="1" parent="1"><mxGeometry x="40.0" y="20" width="190" height="44" as="geometry"/></mxCell><mxCell id="life2" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="64" as="sourcePoint"/><mxPoint x="135.0" y="1039" as="targetPoint"/></mxGeometry></mxCell><mxCell id="part3" value="前端页面<br>（Vue）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11.0;" vertex="1" parent="1"><mxGeometry x="290.0" y="20" width="190" height="44" as="geometry"/></mxCell><mxCell id="life4" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="64" as="sourcePoint"/><mxPoint x="385.0" y="1039" as="targetPoint"/></mxGeometry></mxCell><mxCell id="part5" value="认证控制器<br>（AuthController）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11.0;" vertex="1" parent="1"><mxGeometry x="540.0" y="20" width="190" height="44" as="geometry"/></mxCell><mxCell id="life6" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="64" as="sourcePoint"/><mxPoint x="635.0" y="1039" as="targetPoint"/></mxGeometry></mxCell><mxCell id="part7" value="认证服务<br>（AuthService）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11.0;" vertex="1" parent="1"><mxGeometry x="790.0" y="20" width="190" height="44" as="geometry"/></mxCell><mxCell id="life8" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="64" as="sourcePoint"/><mxPoint x="885.0" y="1039" as="targetPoint"/></mxGeometry></mxCell><mxCell id="part9" value="用户数据访问<br>（UserMapper）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11.0;" vertex="1" parent="1"><mxGeometry x="1040.0" y="20" width="190" height="44" as="geometry"/></mxCell><mxCell id="life10" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="64" as="sourcePoint"/><mxPoint x="1135.0" y="1039" as="targetPoint"/></mxGeometry></mxCell><mxCell id="part11" value="数据库<br>（MySQL 8）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11.0;" vertex="1" parent="1"><mxGeometry x="1290.0" y="20" width="190" height="44" as="geometry"/></mxCell><mxCell id="life12" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385.0" y="64" as="sourcePoint"/><mxPoint x="1385.0" y="1039" as="targetPoint"/></mxGeometry></mxCell><mxCell id="act13" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="130.0" y="132" width="10" height="773" as="geometry"/></mxCell><mxCell id="act14" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="380.0" y="132" width="10" height="773" as="geometry"/></mxCell><mxCell id="act15" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="630.0" y="187" width="10" height="663" as="geometry"/></mxCell><mxCell id="act16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="880.0" y="257" width="10" height="523" as="geometry"/></mxCell><mxCell id="act17" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1130.0" y="327" width="10" height="398" as="geometry"/></mxCell><mxCell id="act18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1380.0" y="382" width="10" height="343" as="geometry"/></mxCell><mxCell id="edge19" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="140" as="sourcePoint"/><mxPoint x="385.0" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg20" value="1. 填写学号、昵称、手机号、密码" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="140" as="sourcePoint"/><mxPoint x="385.0" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge21" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="195" as="sourcePoint"/><mxPoint x="635.0" y="195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg22" value="2. 提交注册请求（POST <br>/api/auth/register）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="195" as="sourcePoint"/><mxPoint x="635.0" y="195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge23" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="265" as="sourcePoint"/><mxPoint x="885.0" y="265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg24" value="3. 参数校验通过，调用 register<br>(dto)" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="265" as="sourcePoint"/><mxPoint x="885.0" y="265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge25" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="335" as="sourcePoint"/><mxPoint x="1135.0" y="335" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg26" value="4. 按学号查询是否已注册" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="335" as="sourcePoint"/><mxPoint x="1135.0" y="335" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge27" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="390" as="sourcePoint"/><mxPoint x="1385.0" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg28" value="5. SELECT * FROM user WHERE <br>student_no = ?" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="390" as="sourcePoint"/><mxPoint x="1385.0" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge29" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385.0" y="460" as="sourcePoint"/><mxPoint x="1135.0" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg30" value="6. 返回记录（无则为 null）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385.0" y="460" as="sourcePoint"/><mxPoint x="1135.0" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge31" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="515" as="sourcePoint"/><mxPoint x="885.0" y="515" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg32" value="7. 返回用户对象（无则为 null）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="515" as="sourcePoint"/><mxPoint x="885.0" y="515" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge33" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="570" as="sourcePoint"/><mxPoint x="1135.0" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg34" value="8. 写入新用户（insert）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="570" as="sourcePoint"/><mxPoint x="1135.0" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge35" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="625" as="sourcePoint"/><mxPoint x="1385.0" y="625" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg36" value="9. INSERT INTO user(...)" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="625" as="sourcePoint"/><mxPoint x="1385.0" y="625" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge37" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385.0" y="680" as="sourcePoint"/><mxPoint x="1135.0" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg38" value="10. 影响行数 1" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385.0" y="680" as="sourcePoint"/><mxPoint x="1135.0" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge39" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="735" as="sourcePoint"/><mxPoint x="635.0" y="735" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg40" value="11. 返回新用户 id" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="735" as="sourcePoint"/><mxPoint x="635.0" y="735" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge41" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="790" as="sourcePoint"/><mxPoint x="385.0" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg42" value="12. 返回 Result{code:200, <br>data:{userId}}" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="790" as="sourcePoint"/><mxPoint x="385.0" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge43" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="860" as="sourcePoint"/><mxPoint x="135.0" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg44" value="13. 提示注册成功，切换到登录页" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="860" as="sourcePoint"/><mxPoint x="135.0" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note45" value="校验（前端 + 后端双重）：<br>　学号 6~12 位数字、昵称 2~12 字<br>　手机号 11 位、密码 ≥6 位含字母数字<br>　两次密码一致" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="941" width="330" height="70" as="geometry"/></mxCell><mxCell id="note46" value="业务规则：学号唯一，已存在返回 1002。<br>密码经 BCrypt(cost=10) 加密后存储，不保存明文。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="490" y="941" width="400" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>