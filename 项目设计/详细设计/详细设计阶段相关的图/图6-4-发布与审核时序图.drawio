><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="710" as="sourcePoint"/><mxPoint x="385.0" y="710" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg47" value="10. 返回 {code:200, <br>data:{id}}" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="710" as="sourcePoint"/><mxPoint x="385.0" y="710" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge48" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="780" as="sourcePoint"/><mxPoint x="135.0" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg49" value="11. 提示发布成功，等待审核" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="780" as="sourcePoint"/><mxPoint x="135.0" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge50" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1885.0" y="835" as="sourcePoint"/><mxPoint x="2135.0" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg51" value="12. 打开待审列表（GET <br>/api/admin/items/audit）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1885.0" y="835" as="sourcePoint"/><mxPoint x="2135.0" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge52" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1885.0" y="905" as="sourcePoint"/><mxPoint x="2135.0" y="905" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg53" value="13. 审核通过（PUT <br>/api/admin/items/{id}/audit）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1885.0" y="905" as="sourcePoint"/><mxPoint x="2135.0" y="905" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge54" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2135.0" y="975" as="sourcePoint"/><mxPoint x="1635.0" y="975" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg55" value="14. UPDATE ... WHERE <br>audit_status=0" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2135.0" y="975" as="sourcePoint"/><mxPoint x="1635.0" y="975" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge56" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2135.0" y="1045" as="sourcePoint"/><mxPoint x="1885.0" y="1045" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg57" value="15. 返回 200（消息在事务提交后<br>推送）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2135.0" y="1045" as="sourcePoint"/><mxPoint x="1885.0" y="1045" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note58" value="图片三重校验（评审 P0-5）：<br>　① 白名单正则 /uploads/yyyyMM/&lt;32 位十六进制&gt;.jpg|png<br>　② 文件必须真实存在；③ 未被其他信息引用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="1141" width="460" height="56" as="geometry"/></mxCell><mxCell id="note59" value="上传：空 4001 / 超 2MB 4002 / 类型或文件头不符 4003。<br>审核：条件更新影响行数 ≠1 → 2003（重复审核或并发）。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="490" y="1141" width="430" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>