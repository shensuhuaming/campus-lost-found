（MySQL 8）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1150" y="16" width="180" height="44" as="geometry"/></mxCell><mxCell id="db_l" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240.0" y="60" as="sourcePoint"/><mxPoint x="1240.0" y="706" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tn" value="事务边界：@Transactional 覆盖第 3~13 步；条件更新影响行数为 0 时&lt;br&gt;抛“状态不允许”业务异常并回滚全部写操作。核验拒绝走 reject 分支：&lt;br&gt;claim.status = 2、物品 item_status 由 1 退回 0，并推送认领结果消息。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;align=left;align=left;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="700" height="66" as="geometry"/></mxCell><mxCell id="RAW1" value="" style="endArrow=none;html=1;endSize=6;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="726" y="700" as="sourcePoint"/><mxPoint x="740" y="714" as="targetPoint"/><Array as="points"><mxPoint x="726" y="714"/></Array></mxGeometry></mxCell><mxCell id="RAW2" value="" style="endArrow=none;html=1;endSize=6;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="726" y="700" as="sourcePoint"/><mxPoint x="740" y="714" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ACT1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="316.5" y="140" width="12" height="520" as="geometry"/></mxCell><mxCell id="ACT2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="541.5" y="182" width="12" height="428" as="geometry"/></mxCell><mxCell id="ACT3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="999.0" y="226" width="12" height="294" as="geometry"/></mxCell><mxCell id="MSG4" value="1. 提交核验请求（PUT /api/claims/{id}/approve）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="97.5" y="120" as="sourcePoint"/><mxPoint x="322.5" y="120" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG5" value="2. 调用核验通过（approve）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="322.5" y="162" as="sourcePoint"/><mxPoint x="547.5" y="162" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG6" value="3. 查询认领记录（selectById）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.5" y="204" as="sourcePoint"/><mxPoint x="1005.0" y="204" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG7" value="4. 执行查询（SELECT * FROM claim WHERE id = ?）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005.0" y="246" as="sourcePoint"/><mxPoint x="1240.0" y="246" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG8" value="5. 返回认领记录（status = 0 待核验）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240.0" y="288" as="sourcePoint"/><mxPoint x="1005.0" y="288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG9" value="6. 返回认领对象（Claim）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005.0" y="330" as="sourcePoint"/><mxPoint x="547.5" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG10" value="7. 状态机校验（1 处理中 → 2 已完成）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.5" y="382" as="sourcePoint"/><mxPoint x="777.5" y="382" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG11" value="8. 条件更新物品状态（updateStatusIf）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.5" y="424" as="sourcePoint"/><mxPoint x="1005.0" y="424" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG12" value="9. 执行更新（UPDATE lost_item SET item_status = 2&lt;br&gt;WHERE id = ? AND item_status = 1）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005.0" y="466" as="sourcePoint"/><mxPoint x="1240.0" y="466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG13" value="10. 影响行数 = 1（为 0 则回滚）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240.0" y="508" as="sourcePoint"/><mxPoint x="1005.0" y="508" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG14" value="11. 更新认领记录（updateApprove）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.5" y="550" as="sourcePoint"/><mxPoint x="1005.0" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG15" value="12. 执行更新（UPDATE claim SET status = 1, reply = ?, admin_id = ?）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005.0" y="592" as="sourcePoint"/><mxPoint x="1240.0" y="592" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG16" value="13. 返回成功（Result.ok）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="547.5" y="634" as="sourcePoint"/><mxPoint x="322.5" y="634" as="targetPoint"/></mxGeometry></mxCell><mxCell id="MSG17" value="14. 响应（code=200, message=&quot;核验成功&quot;）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="322.5" y="676" as="sourcePoint"/><mxPoint x="97.5" y="676" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>