nt"/></mxGeometry></mxCell><mxCell id="edge32" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="415" as="sourcePoint"/><mxPoint x="1135.0" y="415" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg33" value="6. push(A, B, type=2, 摘要)" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="415" as="sourcePoint"/><mxPoint x="1135.0" y="415" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge34" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="470" as="sourcePoint"/><mxPoint x="635.0" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg35" value="7. 返回 {id, createdAt}" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="470" as="sourcePoint"/><mxPoint x="635.0" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge36" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="525" as="sourcePoint"/><mxPoint x="385.0" y="525" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg37" value="8. 返回 200" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="525" as="sourcePoint"/><mxPoint x="385.0" y="525" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge38" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="580" as="sourcePoint"/><mxPoint x="135.0" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg39" value="9. 提示留言成功" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="580" as="sourcePoint"/><mxPoint x="135.0" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge40" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="635" as="sourcePoint"/><mxPoint x="1385.0" y="635" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg41" value="10. 事务提交后 INSERT message" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="635" as="sourcePoint"/><mxPoint x="1385.0" y="635" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge42" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1635.0" y="690" as="sourcePoint"/><mxPoint x="385.0" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg43" value="11. 打开消息中心（GET <br>/api/messages?isRead=0）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1635.0" y="690" as="sourcePoint"/><mxPoint x="385.0" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge44" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="760" as="sourcePoint"/><mxPoint x="1385.0" y="760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg45" value="12. SELECT ... WHERE <br>to_user_id = A" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="760" as="sourcePoint"/><mxPoint x="1385.0" y="760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge46" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="830" as="sourcePoint"/><mxPoint x="1385.0" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg47" value="13. PUT <br>/api/messages/{id}/read → <br>is_read=1" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="830" as="sourcePoint"/><mxPoint x="1385.0" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge48" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="915" as="sourcePoint"/><mxPoint x="1635.0" y="915" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg49" value="14. 未读角标 -1（60 秒轮询 <br>unread-count）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="915" as="sourcePoint"/><mxPoint x="1635.0" y="915" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note50" value="留言规则：物品须存在且已过审（否则 2004）；<br>自己给自己留言不产生消息通知。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="1011" width="380" height="42" as="geometry"/></mxCell><mxCell id="note51" value="消息推送（评审 P0-6）：事务内注册 afterCommit 回调，<br>提交成功后才落库；失败只记日志，不回滚主业务。<br>from_user_id=0 表示系统，其余显示发送人昵称。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="490" y="1011" width="470" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>