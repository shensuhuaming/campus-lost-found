<mxfile host="app.diagrams.net"><diagram id="d" name="列表检索流程图"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" page="1" pageWidth="878" pageHeight="946"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="开始" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="16" width="160" height="38" as="geometry"/></mxCell><mxCell id="a" value="接收 page、size、type、&lt;br&gt;categoryId、keyword" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;size=0.06;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="300" y="82" width="220" height="56" as="geometry"/></mxCell><mxCell id="b" value="参数默认化：page = 1、&lt;br&gt;size = 12（上限 50）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="300" y="172" width="220" height="56" as="geometry"/></mxCell><mxCell id="c" value="构造基础条件：audit_status = 1&lt;br&gt;且 item_status ≠ 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="290" y="262" width="240" height="60" as="geometry"/></mxCell><mxCell id="e" value="keyword 非空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="356" width="240" height="84" as="geometry"/></mxCell><mxCell id="p" value="按发布时间排序&lt;br&gt;ORDER BY created_at DESC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="300" y="476" width="220" height="64" as="geometry"/></mxCell><mxCell id="g" value="匹配 title LIKE ? OR description LIKE ?&lt;br&gt;标题命中优先，其次按时间倒序" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="470" width="260