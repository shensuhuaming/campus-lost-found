<mxfile host="app.diagrams.net"><diagram id="d" name="设计类图（实现级）"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" page="1" pageWidth="2000" pageHeight="1072"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="图 3-4  设计类图（实现级）：纵向为依赖方向，每个类占一列，类框为「名称 / 成员」两段；虚线为依赖，LostItem 组合 ItemImage（1 : N）" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="90" y="6" width="1900" height="24" as="geometry"/></mxCell><mxCell id="c1" value="认证控制器&lt;br&gt;（AuthController）&lt;br&gt;注册（register）／登录（login）&lt;br&gt;退出登录（logout）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;fontSize=10.0;" vertex="1" parent="1"><mxGeometry x="80" y="46" width="256" height="118" as="geometry"/></mxCell><mxCell id="c2" value="个人中心控制器&lt;br&gt;（UserController）&lt;br&gt;个人资料（getProfile）／修改资料（updateProfile）&lt;br&gt;我的消息（listMessages）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;fontSize=10.0;" vertex="1" parent="1"><mxGeometry x="344" y="46" width="256" height="118" as="geometry"/></mxCell><mxCell id="c3" value="失物信息控制器&lt;br&gt;（ItemController）&lt;br&gt;发布（create）／检索（search）&lt;br&gt;关闭（close）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;fontSize=10.0;" vertex="1" parent="1"><mxGeometry x="872" y="46" width="256" height="118" as="geometry"/></mxCell><mxCell id="c4" value="认领控制器&lt;br&gt;（ClaimController）&lt;br&gt;申请（apply）／核验通过（approve）&lt;br&gt;核验拒绝（reject）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;fontSize=10.0;" vertex="1" parent="1"><mxGeometry x="1400" y="46" width="256" height="118" as="geometry"/></mxCell><mxCell id="c5" value="后台管理控制器&lt;br&gt;（AdminController）&lt;br&gt;审核（audit）／分类（category）&lt;br&gt;统计（stats）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;fontSize=10.0;" vertex="1" parent="1"><mxGeometry x="1664" y="46" width="256" height="118" as="geometry"/></mxCell><mxCell id="s1" value="«接口»&lt;br&gt;认证服务&lt;br&gt;（AuthService）&lt;br&gt;注册（register）／登录（login）&lt;br&gt;退出（logout）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="90" y="236" width="236" height="150" as="geometry"/></mxCell><mxCell id="s2" value="«接口»&lt;br&gt;用户服务&lt;br&gt;（UserService）&lt;br&gt;个人资料（profile）／改密（password）&lt;br&gt;我的发布（myItems）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="354" y="236" width="236" height="150" as="geometry"/></mxCell><mxCell id="s3" value="«接口»&lt;br&gt;消息服务&lt;br&gt;（MessageService）&lt;br&gt;推送（push）／列表（page）&lt;br&gt;已读（read）／未读数（countUnread）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="618" y="236" width="236" height="150" as="geometry"/></mxCell><mxCell id="s4" value="«接口»&lt;br&gt;失物信息服务&lt;br&gt;（ItemService）&lt;br&gt;发布（publish）／编辑（edit）&lt;br&gt;检索（search）／详情（detail）&lt;br&gt;关闭（close）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="882" y="236" width="236" height="150" as="geometry"/></mxCell><mxCell id="s5" value="«接口»&lt;br&gt;留言服务&lt;br&gt;（CommentService）&lt;br&gt;发表（add）／删除（remove）&lt;br&gt;按物品分页（pageByItem）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="1146" y="236" width="236" height="150" as="geometry"/></mxCell><mxCell id="s6" value="«接口»&lt;br&gt;认领服务&lt;br&gt;（ClaimService）&lt;br&gt;申请（apply）／核验通过（approve）&lt;br&gt;拒绝（reject）／分页（page）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="1410" y="236" width="236" height="150" as="geometry"/></mxCell><mxCell id="s7" value="«接口»&lt;br&gt;后台服务&lt;br&gt;（AdminService）&lt;br&gt;审核（audit）／分类（category）&lt;br&gt;用户（users）／统计（stats）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="1674" y="236" width="236" height="150" as="geometry"/></mxCell><mxCell id="m1" value="«接口»&lt;br&gt;用户表&lt;br&gt;（UserMapper）&lt;br&gt;按学号查询（selectByStudentNo）&lt;br&gt;更新状态（updateStatus）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.4;" vertex="1" parent="1"><mxGeometry x="354" y="470" width="236" height="122" as="geometry"/></mxCell><mxCell id="m2" value="«接口»&lt;br&gt;消息表&lt;br&gt;（MessageMapper）&lt;br&gt;未读数（countUnread）&lt;br&gt;按用户分页（pageByUser）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.4;" vertex="1" parent="1"><mxGeometry x="618" y="470" width="236" height="122" as="geometry"/></mxCell><mxCell id="m3" value="«接口»&lt;br&gt;失物表&lt;br&gt;（ItemMapper）&lt;br&gt;分页查询（selectPage）&lt;br&gt;条件更新状态（updateStatusIf）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.4;" vertex="1" parent="1"><mxGeometry x="882" y="470" width="236" height="122" as="geometry"/></mxCell><mxCell id="m4" value="«接口»&lt;br&gt;留言表&lt;br&gt;（CommentMapper）&lt;br&gt;按物品查询（selectByItem）&lt;br&gt;按用户分页（pageByUser）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.4;" vertex="1" parent="1"><mxGeometry x="1146" y="470" width="236" height="122" as="geometry"/></mxCell><mxCell id="m5" value="«接口»&lt;br&gt;认领表&lt;br&gt;（ClaimMapper）&lt;br&gt;分页查询（selectPage）&lt;br&gt;核验通过（updateApprove）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.4;" vertex="1" parent="1"><mxGeometry x="1410" y="470" width="236" height="122" as="geometry"/></mxCell><mxCell id="m6" value="«接口»&lt;br&gt;分类表&lt;br&gt;（CategoryMapper）&lt;br&gt;基础增删改查（BaseMapper）&lt;br&gt;统计物品数（countItems）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.4;" vertex="1" parent="1"><mxGeometry x="1674" y="470" width="236" height="122" as="geometry"/></mxCell><mxCell id="entg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;dashed=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="626" width="1820" height="196" as="geometry"/></mxCell><mxCell id="entt" value="实体类（entity）共 7 个：与 lost_found 库的 7 张表一一对应，字段定义见概要设计说明书第 5 章" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="104" y="790" width="1600" height="22" as="geometry"/></mxCell><mxCell id="e6" value="图片&lt;br&gt;（ItemImage）&lt;br&gt;（item_id, url, sort）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="90" y="662" width="236" height="84" as="geometry"/></mxCell><mxCell id="e0" value="用户&lt;br&gt;（User）&lt;br&gt;（student_no, role）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="354" y="662" width="236" height="84" as="geometry"/></mxCell><mxCell id="e4" value="站内消息&lt;br&gt;（Message）&lt;br&gt;（is_read, type）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="618" y="662" width="236" height="84" as="geometry"/></mxCell><mxCell id="e1" value="失物信息&lt;br&gt;（LostItem）&lt;br&gt;（item_status, audit_status）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="882" y="662" width="236" height="84" as="geometry"/></mxCell><mxCell id="e3" value="留言&lt;br&gt;（Comment）&lt;br&gt;（item_id, user_id）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="1146" y="662" width="236" height="84" as="geometry"/></mxCell><mxCell id="e2" value="认领申请&lt;br&gt;（Claim）&lt;br&gt;（status, admin_id）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="1410" y="662" width="236" height="84" as="geometry"/></mxCell><mxCell id="e5" value="分类&lt;br&gt;（Category）&lt;br&gt;（name, sort）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="1674" y="662" width="236" height="84" as="geometry"/></mxCell><mxCell id="supg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;dashed=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="838" width="1820" height="168" as="geometry"/></mxCell><mxCell id="supt" value="公共支撑类（被上述各层复用）" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="104" y="846" width="900" height="22" as="geometry"/></mxCell><mxCell id="sp0" value="状态机（ItemStatusMachine）&lt;br&gt;状态迁移校验&lt;br&gt;条件更新" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="100" y="878" width="332" height="112" as="geometry"/></mxCell><mxCell id="sp1" value="文件工具（FileUtil）&lt;br&gt;图片校验与落盘&lt;br&gt;uploads/yyyyMM/uuid.ext" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="452" y="878" width="332" height="112" as="geometry"/></mxCell><mxCell id="sp2" value="令牌拦截器（JwtInterceptor）&lt;br&gt;令牌解析&lt;br&gt;当前用户注入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="804" y="878" width="332" height="112" as="geometry"/></mxCell><mxCell id="sp3" value="全局异常处理（GlobalExceptionHandler）&lt;br&gt;统一响应&lt;br&gt;异常转换" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="1156" y="878" width="332" height="112" as="geometry"/></mxCell><mxCell id="sp4" value="数据初始化（DataInitializer）&lt;br&gt;启动时幂等创建&lt;br&gt;管理员账号 admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;fontSize=9.6;" vertex="1" parent="1"><mxGeometry x="1508" y="878" width="332" height="112" as="geometry"/></mxCell><mxCell id="note" value="注：虚线箭头表示「依赖 / 调用」。控制器只依赖业务接口，业务只依赖数据访问接口，便于替换实现与单元测试；实体类只在业务与数据访问之间传递，不向外暴露。" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1020" width="1820" height="44" as="geometry"/></mxCell><mxCell id="EDGE0" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;endSize=6;strokeColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c1" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="EDGE1" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;endSize=6;strokeColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c2" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="EDGE2" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;endSize=6;strokeColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c2" target="s3"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="206"/><mxPoint x="736" y="206"/></mxGeometry></mxCell><mxCell id="EDGE3" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;endSize=6;strokeColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="EDGE4" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;endSize=6;strokeColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c3" target="s5"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="206"/><mxPoint x="1264" y="206"/></mxGeometry></mxCell><mxCell id="EDGE5" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;endSize=6;strokeColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c4" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="EDGE6" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;endSize=6;strokeColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c5" target="s7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="EDGE7" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;endSize=6;strokeColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="s2" target="m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="EDGE8" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classic;endSize=6;strokeColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="s3" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="EDGE9" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=classi