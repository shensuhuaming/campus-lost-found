<mxfile host="app.diagrams.net"><diagram id="d" name="注册流程图"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" page="1" pageWidth="553" pageHeight="1034"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="开始" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="16" width="310" height="38" as="geometry"/></mxCell><mxCell id="n2" value="输入学号、昵称、手机号、密码、确认密码" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;size=0.06;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="84" width="310" height="64" as="geometry"/></mxCell><mxCell id="n3" value="前端校验：学号 6~12 位数字、密码不少于 6 位&lt;br&gt;两次密码一致、手机 11 位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="178" width="310" height="68" as="geometry"/></mxCell><mxCell id="n4" value="校验通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="276" width="310" height="88" as="geometry"/></mxCell><mxCell id="n5" value="提示“输入不合法”&lt;br&gt;并高亮错误字段" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;size=0.06;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="291.0" width="190" height="58" as="geometry"/></mxCell><mxCell id="n6" value="查询学号是否已注册&lt;br&gt;selectByStudentNo(studentNo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="394" width="310" height="64" as="geometry"/></mxCell><mxCell id="n7" value="学号已存在？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="488" width="310" height="88" as="geometry"/></mxCe