left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="204" y="516" width="972" height="180" as="geometry"/></mxCell><mxCell id="u112" value="账号状态说明" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="220" y="530" width="300" height="24" as="geometry"/></mxCell><mxCell id="u113" value="· 禁用后该账号立即无法登录，已签发的令牌在过期前仍可访问，故服务端每次请求校验 status（见 8.1）；" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="566" width="930" height="24" as="geometry"/></mxCell><mxCell id="u114" value="· 管理员账号不可被禁用，当前登录账号自身也禁止禁用，避免锁死后台；" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="598" width="930" height="24" as="geometry"/></mxCell><mxCell id="u115" value="· 用户列表只返回昵称、掩码手机号与学号，不返回密码与完整联系方式。" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="630" width="930" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>