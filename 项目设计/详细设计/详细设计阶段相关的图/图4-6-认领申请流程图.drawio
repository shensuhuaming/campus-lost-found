<mxfile host="app.diagrams.net"><diagram id="d" name="认领申请流程图"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" page="1" pageWidth="573" pageHeight="1096"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="开始" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="16" width="330" height="38" as="geometry"/></mxCell><mxCell id="n2" value="校验登录状态，读取 itemId 与认领说明" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="84" width="330" height="52" as="geometry"/></mxCell><mxCell id="n3" value="查询失物详情 selectById(itemId)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="166" width="330" height="52" as="geometry"/></mxCell><mxCell id="n4" value="失物存在且已审核通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="248" width="330" height="84" as="geometry"/></mxCell><mxCell id="n5" value="提示“该信息不存在&lt;br&gt;或未通过审核”" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;size=0.06;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="261.0" width="190" height="58" as="geometry"/></mxCell><mxCell id="n6" value="非本人发布？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="235.0" y="362" width="330" height="84" as="geometry"/></mxCell><mxCell id="n7" value="提示“不能认领自己发布的信息”" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;size=0.06;fontSize=12;" vertex="1" parent="1"><mxGeometry x="16" y="378.0" width="205" height="52" as="geometry"/></mxCell><mxCell id="n8" value="物品状态为进行中或处理中？" style=