"act17" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1130.0" y="312" width="10" height="318" as="geometry"/></mxCell><mxCell id="act18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1380.0" y="522" width="10" height="108" as="geometry"/></mxCell><mxCell id="edge19" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="140" as="sourcePoint"/><mxPoint x="385.0" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg20" value="1. 打开「数据统计」页签" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="140" as="sourcePoint"/><mxPoint x="385.0" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge21" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="195" as="sourcePoint"/><mxPoint x="635.0" y="195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg22" value="2. GET <br>/api/admin/stats?days=30" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="195" as="sourcePoint"/><mxPoint x="635.0" y="195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge23" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="265" as="sourcePoint"/><mxPoint x="885.0" y="265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg24" value="3. stats(30)" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="265" as="sourcePoint"/><mxPoint x="885.0" y="265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge25" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="320" as="sourcePoint"/><mxPoint x="1135.0" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg26" value="4. 统计总数、待审核、已完成认领<br>（selectCount）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="320" as="sourcePoint"/><mxPoint x="1135.0" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge27" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="390" as="sourcePoint"/><mxPoint x="1135.0" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg28" value="5. 按分类聚合（GROUP BY <br>category_id）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="390" as="sourcePoint"/><mxPoint x="1135.0" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge29" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="460" as="sourcePoint"/><mxPoint x="1135.0" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg30" value="6. 按天聚合（GROUP BY DATE(<br>created_at)）" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="460" as="sourcePoint"/><mxPoint x="1135.0" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge31" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="530" as="sourcePoint"/><mxPoint x="1385.0" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg32" value="7. 执行 6 条聚合 SQL" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1135.0" y="530" as="sourcePoint"/><mxPoint x="1385.0" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge33" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385.0" y="585" as="sourcePoint"/><mxPoint x="1135.0" y="585" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg34" value="8. 返回结果集" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1385.0" y="585" as="sourcePoint"/><mxPoint x="1135.0" y="585" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge35" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="640" as="sourcePoint"/><mxPoint x="635.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg36" value="9. 补零并计算归还率，返回 <br>StatsVO" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885.0" y="640" as="sourcePoint"/><mxPoint x="635.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge37" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="710" as="sourcePoint"/><mxPoint x="385.0" y="710" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg38" value="10. 返回指标、分类分布、30 天趋<br>势" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635.0" y="710" as="sourcePoint"/><mxPoint x="385.0" y="710" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge39" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="780" as="sourcePoint"/><mxPoint x="135.0" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg40" value="11. 渲染指标卡与 ECharts 饼图 <br>/ 折线图" style="endArrow=classic;endSize=6;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="780" as="sourcePoint"/><mxPoint x="135.0" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note41" value="权限：先 requireAdmin()，非管理员返回 2002。<br>归还率 = 已完成拾物 ÷ 已过审拾物。<br>趋势默认 30 天（7~30 可调），无数据的日期补 0。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="876" width="400" height="56" as="geometry"/></mxCell><mxCell id="note42" value="图表按需加载：ECharts 单独分包，前台页面不加载。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="490" y="876" width="380" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>